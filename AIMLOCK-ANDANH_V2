-- Xử lý Nút Fix Lag (Xóa rác map)
FixLagButton.MouseButton1Click:Connect(function()
    for _, v in pairs(workspace:GetChildren()) do
        if v.Name == "Bullets" or v.Name == "Debris" or v.Name == "FX" or v.Name == "Projectiles" then
            v:Destroy()
        end
    end
    
    for _, v in pairs(workspace:GetDescendants()) do
        if not v:IsDescendantOf(LocalPlayer.Character) and not game.Players:GetPlayerFromCharacter(v:FindFirstAncestorOfClass("Model")) then
            if v:IsA("Part") or v:IsA("UnionOperation") or v:IsA("MeshPart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
                v.Enabled = false
            end
        end
    end
    
    FixLagButton.Text = "Trash Cleared!"
    FixLagButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    task.wait(2)
    FixLagButton.Text = "FIX LAG: Clear Trash"
end)

-- Xử lý Nút ESP Tracers (Vẽ dây trắng nối từ vị trí người chơi đến đối thủ)
local espEnabled = false
local tracersTable = {}

EspButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    
    if espEnabled then
        EspButton.Text = "ESP Tracers: ON"
        EspButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        EspButton.Text = "ESP Tracers: OFF"
        EspButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
        -- Xóa toàn bộ đường dây khi tắt
        for _, line in pairs(tracersTable) do
            line:Remove()
        end
        tracersTable = {}
    end
end)

RunService.RenderStepped:Connect(function()
    -- Dọn dẹp line cũ mỗi frame
    for _, line in pairs(tracersTable) do
        line.Visible = false
    end
    
    if espEnabled then
        local index = 1
        for _, player in pairs(game.Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
                local humanoid = player.Character:FindFirstChild("Humanoid")
                
                if rootPart and humanoid and humanoid.Health > 0 then
                    local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    if onScreen then
                        local line = tracersTable[index]
                        if not line then
                            line = Drawing.new("Line")
                            line.Thickness = 1.5
                            line.Color = Color3.fromRGB(255, 255, 255) -- Dây màu trắng
                            line.Transparency = 1
                            tracersTable[index] = line
                        end
                        
                        -- Nối từ chính giữa đáy màn hình (hoặc tâm) đến nhân vật địch
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(vector.X, vector.Y)
                        line.Visible = true
                        index = index + 1
                    end
                end
            end
        end
    end
end)
