-- Xử lý Nút Aimlock (Hitbox Thân đỏ chống kẹt tường)
local aimlockEnabled = false
AimButton.MouseButton1Click:Connect(function()
    aimlockEnabled = not aimlockEnabled
    
    if aimlockEnabled then
        AimButton.Text = "Aimlock: ON"
        AimButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        AimButton.Text = "Aimlock: OFF"
        AimButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    end
    
    task.spawn(function()
        while aimlockEnabled do
            local customSize = tonumber(SizeBox.Text) or 15
            for _, player in pairs(game.Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local targetPart = player.Character:FindFirstChild("HumanoidRootPart") 
                                  or player.Character:FindFirstChild("Torso") 
                                  or player.Character:FindFirstChild("UpperTorso")
                    if targetPart then
                        targetPart.Size = Vector3.new(customSize, customSize, customSize)
                        targetPart.Color = Color3.fromRGB(255, 0, 0)
                        targetPart.Material = Enum.Material.Neon
                        targetPart.Transparency = 0.5
                        targetPart.CanCollide = false
                    end
                end
            end
            task.wait(0.5)
        end
        
        for _, player in pairs(game.Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local targetPart = player.Character:FindFirstChild("HumanoidRootPart") 
                              or player.Character:FindFirstChild("Torso") 
                              or player.Character:FindFirstChild("UpperTorso")
                if targetPart then
                    targetPart.Size = Vector3.new(2, 2, 1)
                    targetPart.Transparency = 1
                    targetPart.CanCollide = true
                end
            end
        end
    end)
end)

